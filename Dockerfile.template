# Node.js 22.23.4 is the first 22.x release whose bundled root store distrusts
# the compromised eMudhra intermediate CAs. balenalib images are no longer
# updated, so use the multi-arch Docker Official Image.
FROM node:22.23.4-alpine3.24 as build

# Install node dependencies
COPY package*.json ./
RUN npm install --production && npm cache clean --force && rm -rf /tmp/*


FROM node:22.23.4-alpine3.24 as run
# Full ca-certificates package provides the per-root files AWS_ROOT_CA_PATH uses
RUN apk add --no-cache ca-certificates
# Fail if ca-certificates predates the eMudhra CA distrust (Alpine fix: 20261020-r0)
RUN for p in ca-certificates ca-certificates-bundle; do \
      v="$(apk list --installed "$p" | sed -n "s/^$p-\([0-9][^ ]*\) .*/\1/p")"; \
      [ -n "$v" ] && [ "$(apk version -t "$v" 20261020-r0)" != "<" ] \
        || { echo "$p '$v' predates eMudhra CA distrust fix 20261020-r0"; exit 1; }; \
    done
# pathname specific to distro
ENV AWS_ROOT_CA_PATH="/etc/ssl/certs/ca-cert-Amazon_Root_CA_1.pem"

WORKDIR /app
COPY --from=build ./node_modules ./node_modules
COPY index.js package.json ./
COPY lib/ ./lib

# Start the container
CMD ["npm", "start"]
